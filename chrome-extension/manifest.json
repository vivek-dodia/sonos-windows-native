{
  "manifest_version": 3,
  "name": "Sonos Sync",
  "version": "1.0.0",
  "description": "Holds web video back by the Sonos Cast delay so picture and Sonos sound line up.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Sonos Sync" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8080/*"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
